def reconcile(args):
 """Resolve a network-ambiguous submission; never assume a missing ID means no IBM job."""
 if not args.treatment:raise RuntimeError('--treatment required, e.g. M2_TREX')
 if args.treatment not in [x[0] for x in TREATMENTS]:raise RuntimeError('Unknown treatment')
 root,base,source,out=paths(args);p=ibm_round_dir(base,args.round)/args.treatment
 state=p/'submission_state.json'; submitted=p/'job_submitted.json'
 if submitted.exists():raise RuntimeError('Already has saved job ID. No reconciliation needed.')
 if not state.exists():raise RuntimeError('No ambiguous SUBMITTING state to reconcile')
 old=load(state)
 if old.get('status')!='SUBMITTING':raise RuntimeError('State is not ambiguous SUBMITTING')
 if args.job_id and args.confirm_not_submitted:raise RuntimeError('Select only one reconciliation action')
 if args.job_id:
  if not identity_matches(old,args):raise RuntimeError('Use original --account-label and --instance to verify the job')
  svc=service_obj(args);job=svc.job(args.job_id)
  if str(job.backend().name)!='ibm_fez':raise RuntimeError('Job backend is not ibm_fez')
  # IBM cannot always attest which PUB configuration was submitted. User must compare
  # IBM job detail with the local treatment plan, then explicitly acknowledge it.
  if not args.confirm_job_matches:raise RuntimeError('Review IBM job details; add --confirm-job-matches to adopt')
  _,lock=check_lock(base)
  info={'job_id':args.job_id,'backend':'ibm_fez','treatment':args.treatment,
        'account_label':account_key(args),'instance':args.instance,
        'attempt_id':old['attempt_id'],'repeats':old['repeats'],
        'shots_requested_per_pub':old['shots'],
        'base_ISA_sha256':lock['hashes']['circuit.qpy'],'theta_sha256':lock['hashes']['theta.csv'],
        'observables_sha256':lock['hashes']['observables.json'],
        'reconciled_utc':stamp(),'reconciliation_note':'IBM job verified accessible; user confirmed treatment correspondence'}
  exclusive_json(info,submitted)
  atomic_json({**old,'status':'SUBMITTED','job_id':args.job_id,'reconciled_utc':stamp()},state)
  print('RECONCILED saved job ID',args.job_id)
 elif args.confirm_not_submitted:
  if not args.checked_ibm_jobs:raise RuntimeError('Check IBM Jobs under original account, then add --checked-ibm-jobs')
  atomic_json({**old,'status':'CONFIRMED_NOT_SUBMITTED','reconciled_utc':stamp(),
               'manual_confirmation':'Operator checked IBM Jobs; no accepted job exists'},state)
  print('MANUALLY marked as not submitted; a future --resume can retry this treatment')
 else:raise RuntimeError('Supply --job-id ID --confirm-job-matches OR --confirm-not-submitted --checked-ibm-jobs')

