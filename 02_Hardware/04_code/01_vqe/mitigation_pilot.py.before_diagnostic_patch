                 **{f'std_Z{j}':float(std[j]) if j<len(std) else float('nan') for j in range(7)}})
   if len(rows)!=args.repeats:
    raise ValueError(f'{name}: IBM returned {len(rows)} PUBs, expected {args.repeats}')
   rows,source_map,changes=_recovery_overlay(base,args.round,name,rows,jid)
   _validated_rows(rows,args.repeats,name)
   # Never overwrite collected files; atomic publication of validated CSV.
   if (p/'expectations.csv').exists() or (p/'result.json').exists():
    raise RuntimeError('Existing collection files; refusing overwrite')
   exclusive_json({'original_job_id':jid,'per_pub_job_id':source_map,'replacements':changes},p/'pub_source_manifest.json')
   (p/'result.json').write_text(json.dumps(result,cls=RuntimeEncoder,indent=2),encoding='utf-8')
   csvout(p/'expectations.csv',rows)
   js(_runtime_serializable(metrics),p/'job_metrics_raw.json')
   if next(t[3] for t in TREATMENTS if t[0]==name):_extract_zne_intermediates(result,name,p)
   # Capture PUB metadata in addition to expectation values and their standard errors.
   js([{'pub':i+1,'metadata':_runtime_serializable(getattr(pr,'metadata',{})),
        'available_data_fields':list(_pub_data_fields(pr))} for i,pr in enumerate(result)],
      p/'pub_result_metadata.json')
   try:
    job_inputs=job.inputs
