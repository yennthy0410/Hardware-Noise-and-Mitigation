def _runtime_serializable(obj):
 """Serialize Runtime DataBin or nested metadata without inventing unavailable fields."""
 from qiskit_ibm_runtime import RuntimeEncoder
 try:
  return json.loads(json.dumps(obj,cls=RuntimeEncoder,default=str))
 except Exception:
  if hasattr(obj,'items'):
   return {str(k):_runtime_serializable(v) for k,v in obj.items()}
  if hasattr(obj,'__dict__'):
   return {str(k):_runtime_serializable(v) for k,v in vars(obj).items() if not k.startswith('_')}
  return str(obj)

def _pub_data_fields(pub):
 data=pub.data
 keys=[]
 if hasattr(data,'keys'):
  try:keys=list(data.keys())
  except Exception:pass
 if not keys:
  try:keys=[k for k in vars(data) if not k.startswith('_')]
  except Exception:pass
 return {str(k):_runtime_serializable(getattr(data,k)) for k in keys}

def _extract_zne_intermediates(result, treatment, dest):
 """Archive unmodified ZNE-related Estimator data by PUB, only if IBM supplied it."""
 all_pubs=[]; factor_rows=[]
 for idx,pub in enumerate(result,1):
  fields=_pub_data_fields(pub)
  zfields={k:v for k,v in fields.items() if any(w in k.lower() for w in
     ('noise_factor','extrapolat','zne','stds_noise','evs_noise','ensemble'))}
  meta=_runtime_serializable(getattr(pub,'metadata',{}))
  if any(w in str(meta).lower() for w in ('zne','noise_factor','extrapolat')):
   zfields['pub_metadata']=meta
  if not zfields:continue
  all_pubs.append({'pub':idx,'data_fields':zfields})
  # Preserve full arrays (including multidimensional raw factor data) in JSON.
  factors=zfields.get('noise_factors')
  evs=zfields.get('evs_noise_factors')
  stds=zfields.get('stds_noise_factors')
  if factors is not None and evs is not None:
   import numpy as np
   f=np.asarray(factors).ravel();v=np.asarray(evs)
   # Only produce long-form rows when the last axis matches factor count.
   if v.ndim>=1 and v.shape[-1]==len(f):
    u=np.asarray(stds) if stds is not None else None
    for obs_i in np.ndindex(v.shape[:-1]):
     for j,fac in enumerate(f):
      val=v[obs_i+(j,)];sd=(u[obs_i+(j,)] if u is not None and u.shape==v.shape else None)
      factor_rows.append({'pub':idx,'observable_index':','.join(map(str,obs_i)),
                         'noise_factor':float(fac),'expectation':float(val),
                         'std_error':float(sd) if sd is not None else None})
 if all_pubs:
  js({'treatment':treatment,'pubs':all_pubs,
      'note':'IBM Runtime-supplied intermediate ZNE values; original result.json remains authoritative.'},
      dest/'zne_intermediate.json')
  if factor_rows:csvout(dest/'zne_noise_factors.csv',factor_rows)
 else:
  # Presence/absence is explicit; avoid claiming intermediate circuits are available.
  js({'treatment':treatment,'available':False,
      'reason':'No ZNE intermediate arrays exposed in Runtime PUB results.'},dest/'zne_intermediate_status.json')

def _qpu_seconds(raw):
 """Extract IBM QPU billed seconds from recorded job metrics; never infer from wall time."""
 if not isinstance(raw,dict):return None
 candidates=[raw.get('qpu_usage_s'),raw.get('quantum_seconds'),raw.get('qpu_seconds'),
             raw.get('usage'),raw.get('usage_estimation'),raw.get('metrics_raw')]
 for candidate in candidates:
  if isinstance(candidate,dict):
   for key in ('quantum_seconds','qpu_seconds','qpu_usage_s','usage_seconds'):
    val=candidate.get(key)
    if isinstance(val,(int,float)) and np.isfinite(val) and val>=0:return float(val)
  elif isinstance(candidate,(float,int)) and np.isfinite(candidate) and candidate>=0:return float(candidate)
 return None

