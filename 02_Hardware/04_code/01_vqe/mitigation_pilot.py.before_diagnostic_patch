def _classical_sse_reference(root):
 """Read and cross-check the frozen Study A Classical SSE reference."""
 import pandas as pd
 root=Path(root)
 metrics=root/'01_quantum_eis_fit'/'01_vqe'/'output'/'EIS14_VQE_metrics.csv'
 spectrum=root/'01_quantum_eis_fit'/'01_vqe'/'output'/'classical_fitted_spectrum.csv'
 if not metrics.is_file() or not spectrum.is_file():
  raise FileNotFoundError('Verified Study A Classical SSE metrics/spectrum are required')
 metric=pd.read_csv(metrics)
 rows=metric.loc[(metric['dataset']=='EIS14')&(metric['method']=='Classical')]
 if len(rows)!=1:raise ValueError('Study A must contain one EIS14 Classical metrics row')
 reported=float(rows.iloc[0]['SSE_ohm2'])
 frame=pd.read_csv(spectrum)
 needed={'residual_real_fit_minus_data_ohm','residual_imag_fit_minus_data_ohm'}
 if not needed.issubset(frame.columns) or len(frame)!=132:
  raise ValueError('Study A Classical fitted spectrum schema or 132-point coverage is invalid')
 residual=frame[list(needed)].to_numpy(dtype=float)
 if not np.isfinite(residual).all():raise ValueError('Study A Classical residuals contain nonfinite values')
 computed=float(np.sum(residual[:,0]**2+residual[:,1]**2))
 if not np.isclose(computed,reported,rtol=1e-10,atol=1e-9):
  raise ValueError('Study A Classical SSE does not match its archived residual spectrum')
 return reported


def sse_plot_statistics(frame):
 """Treatment-ordered statistics for validated, actual per-PUB SSE rows."""
 ordered=[item[0] for item in TREATMENTS]
 if not {'treatment','SSE'}.issubset(frame.columns):
  raise ValueError('Per-PUB plot data requires treatment and SSE columns')
 result=[]
 for name in ordered:
  values=frame.loc[frame.treatment==name,'SSE'].to_numpy(dtype=float)
  if not len(values):raise ValueError(f'No validated PUB SSE values for {name}')
  if not np.isfinite(values).all() or np.any(values<=0):
   raise ValueError(f'Invalid/nonpositive SSE present for {name}; refusing to silently drop PUB data')
  result.append({'treatment':name,'count':int(len(values)),
      'median_SSE':float(np.median(values)),
      'q25_SSE':float(np.percentile(values,25)),
      'q75_SSE':float(np.percentile(values,75)),
      'min_SSE':float(np.min(values)),'max_SSE':float(np.max(values))})
 return result


