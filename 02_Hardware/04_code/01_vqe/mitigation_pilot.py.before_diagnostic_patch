def publication_mitigation_figures(out, freq, zexp, curves, df, labels, summaries, names=NAMES,
                                   partial_title: str | None = None, n: int | None = None):
    """Seven independent, consistent square 600-DPI journal figures.

    Visualization-only: original measured and calculated arrays are unchanged.
    Legends are inside the plotting axes in a reserved upper region.
    """
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    from matplotlib.ticker import MaxNLocator
    out = Path(out)
    freq = np.asarray(freq, dtype=float)
    zexp = np.asarray(zexp, dtype=complex)
    order = np.argsort(freq)
    f = freq[order]
    eps = np.finfo(float).eps
    palette = plt.get_cmap('tab10').colors
    series = ({'Ideal': np.asarray(curves['Ideal'], dtype=complex)}
              if 'Ideal' in curves else {})
    series.update({treatment_display(name): np.asarray(curves[name], dtype=complex)
                   for name in labels})
    colors = {'Ideal': '#2671a5', **{treatment_display(name): palette[i % len(palette)]
                                    for i, name in enumerate(labels)}}
    created = []
    # 8-inch source, designed for reduction to a journal column.
    # At 89 mm published width scale factor is ~0.438.
    # Source 18pt axis labels become ~7.9pt; 14pt legend becomes ~6.1pt.
    with plt.rc_context({'font.family': 'DejaVu Sans', 'font.size': 12,
                         'axes.labelsize': 16, 'axes.titlesize': 16,
                         'axes.linewidth': 2.0, 'xtick.labelsize': 12,
                         'ytick.labelsize': 12, 'xtick.direction': 'in',
                         'ytick.direction': 'in', 'xtick.top': True,
                         'ytick.right': True, 'xtick.major.width': 1.2,
                         'ytick.major.width': 1.2,
                         'savefig.facecolor': 'white'}):
        def render(key, xlabel, ylabel, draw, *, zero=False, xlim=None, ylim=None):
            target = out / ('publication_' + key + '.png')
            if target.exists():
                raise FileExistsError('Refusing to overwrite publication figure: ' + str(target))
            fig = plt.figure(figsize=(8, 8), facecolor='white')
            # Dedicated top band for the legend: no overlap with data or title.
            ax = fig.add_axes([0.18, 0.17, 0.78, 0.78])  # balanced square axes on 8 x 8 inch canvas
            try:
                if zero:
                    ax.axhline(0, color='#666666', linewidth=0.9, alpha=0.75)
                draw(ax)
                ax.set_xlabel(xlabel, labelpad=11)
                ax.set_ylabel(ylabel, labelpad=13)
                ax.tick_params(axis='both', which='major', pad=7, length=6)
                ax.tick_params(axis='both', which='minor', length=3)
                ax.yaxis.set_major_locator(MaxNLocator(nbins=5))
                if xlim is not None:
                    ax.set_xlim(*xlim)
                if ylim is not None:
                    ax.set_ylim(*ylim)
                for spine in ax.spines.values():
                    spine.set_linewidth(2.0)
                handles, names_ = ax.get_legend_handles_labels()
                if handles:
                    # Inside axes, same two-column layout as the supplied sample.
                    # Do not alter data, series colors, residual transforms or axis limits.
                    ax.legend(handles, names_, loc='upper left' if key == 'nyquist' else 'best',
                              ncol=2, fontsize=9, frameon=False, handlelength=2.0,
                              columnspacing=1.0, labelspacing=0.32,
                              borderaxespad=0.55)
                fig.savefig(target, dpi=600, facecolor='white')
                created.append(target.name)
            finally:
                plt.close(fig)
        def nyquist(ax):
            ax.plot(zexp.real, -zexp.imag, 'o', ms=5.0,
                    color='#1d70b2', label='Experimental', zorder=10)
            for name, z in series.items():
                ax.plot(z.real, -z.imag, linewidth=2.2,
                        color=colors[name], label=name)
        render('nyquist', r"$Z^{\prime}$ ($\Omega$)",
               r"$-Z^{\prime\prime}$ ($\Omega$)", nyquist,
               xlim=(0, 60), ylim=(0, 300))
        for key, transform, ylabel in [
            ('bode_magnitude', np.abs, r'$|Z|$ ($\Omega$)'),
            ('bode_phase', lambda z: np.angle(z, deg=True), 'Phase (deg)')]:
            def draw(ax, transform=transform):
                ax.semilogx(f, transform(zexp)[order], 'o', ms=5.0,
                            color='#1d70b2', label='Experimental', zorder=10)
                for name, z in series.items():
                    ax.semilogx(f, transform(z)[order], linewidth=2.2,
                                color=colors[name], label=name)
            render(key, 'Frequency (Hz)', ylabel, draw)
        for key, transform, ylabel in [
            ('residual_real', lambda d: d.real,
             r'Re[$Z_{fit}-Z_{exp}$] ($\Omega$)'),
            ('residual_imag', lambda d: d.imag,
             r'Im[$Z_{fit}-Z_{exp}$] ($\Omega$)'),
            ('residual_real_normalized',
             lambda d: d.real / np.maximum(np.abs(zexp), eps),
             r'$\mathrm{Re}(\Delta Z)/|Z_{data}|$'),
            ('residual_imag_normalized',
             lambda d: d.imag / np.maximum(np.abs(zexp), eps),
             r'$\mathrm{Im}(\Delta Z)/|Z_{data}|$')]:
            def draw(ax, transform=transform):
                for name, z in series.items():
                    ax.semilogx(f, transform(z - zexp)[order],
                                linewidth=2.0, marker='o', markersize=2.4,
                                color=colors[name], label=name)
            render(key, 'Frequency (Hz)', ylabel, draw, zero=True)
    return created

