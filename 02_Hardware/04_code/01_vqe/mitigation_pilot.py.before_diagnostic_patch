def verify_source(source, root=None):
 source=frozen_source(root,source)
 from qiskit import qpy
 from qiskit.quantum_info import SparsePauliOp,Statevector
 from qiskit import __version__ as qver
 qcpath=source/'circuit.qpy'; theta_path=source/'theta.csv'; obspath=source/'observables.json'
 for p in [qcpath,theta_path,obspath]:
  if not p.exists():raise FileNotFoundError(f'Missing {p}')
 with qcpath.open('rb') as f:qc=qpy.load(f)[0]
 if qc.num_qubits<7:raise RuntimeError(f'ISA circuit only {qc.num_qubits} wires')
 import pandas as pd
 try:
  theta=np.loadtxt(theta_path,delimiter=',',ndmin=1).ravel()
 except ValueError:
  frame=pd.read_csv(theta_path)
  key=next((c for c in ('theta_rad','optimal_angle_rad','angle_rad','value') if c in frame),None)
  if key is None:raise ValueError(f'Cannot find theta column in {theta_path}')
  theta=frame[key].to_numpy(dtype=float)
 if len(theta)!=21 or not np.isfinite(theta).all():raise RuntimeError('theta.csv must contain 21 finite values')
 if len(qc.parameters):
  raise RuntimeError('Saved ISA still parameterized. Prepare with bound Fixed ISA circuit.qpy from Study A or explicitly rebuild with known parameter order.')
 arr=load(obspath)
 if isinstance(arr,dict):arr=arr.get('observables',arr.get('paulis',[]))
 obs=[]
 for value in arr:
  # Qiskit SparsePauliOp.to_list() serializes as [[pauli, complex coeff], ...]
  if isinstance(value,dict):value=value.get('isa_sparse_pauli',value.get('paulis',value))
  if isinstance(value,str):obs.append(SparsePauliOp(value));continue
  try:obs.append(SparsePauliOp.from_list([(p,complex(c)) for p,c in value]))
  except Exception as exc:raise ValueError(f'Cannot parse observables.json entry {value}: {exc}')
 if len(obs)!=7:raise RuntimeError(f'Expected seven observables, got {len(obs)}')
 for o in obs:
  if o.num_qubits!=qc.num_qubits:raise RuntimeError('Observable/ISA circuit wire count mismatch')
 # physical indices used for single-Z observable
 physical=[]
 for o in obs:
  lab=o.paulis[0].to_label(); physical.append(qc.num_qubits-1-lab.index('Z') if lab.count('Z')==1 else None)
 if any(q is None for q in physical) or len(set(physical))!=7:
  raise RuntimeError(f'Observables not seven distinct physical single-Z measurements: {physical}')
 # A backend-wide ISA (e.g. 156 physical wires) must NEVER be simulated by Statevector.
 # Recompute ideal on the original seven-logical-qubit HEA at the locked angles.
 register_science(root)
 from hea_ansatz import build_hea_7qubit_3layer,assign_angles
 logical,parameters=build_hea_7qubit_3layer(measure=False)
 bound=assign_angles(logical,parameters,theta)
 from qiskit.quantum_info import Statevector
 state=Statevector.from_instruction(bound)
 logical_obs=[SparsePauliOp('I'*(6-i)+'Z'+'I'*i) for i in range(7)]
 ev=np.array([float(state.expectation_value(o).real) for o in logical_obs])
 return qc,obs,theta,physical,ev,qver

def configuration(name,shots):
 from qiskit_ibm_runtime.options import EstimatorOptions
 item=next(x for x in TREATMENTS if x[0]==name); _,dd,trex,zne=item
 o=EstimatorOptions();o.resilience_level=0;o.default_shots=shots
 o.dynamical_decoupling.enable=bool(dd)
 o.dynamical_decoupling.sequence_type='XpXm'
 o.dynamical_decoupling.scheduling_method='alap'
 o.resilience.measure_mitigation=bool(trex)
 o.resilience.zne_mitigation=bool(zne)
 o.resilience.pec_mitigation=False
 o.twirling.enable_gates=False
 # Do NOT force measurement twirling off when TREX requires it.
 if zne:
  o.resilience.zne.noise_factors=(1,3,5)
  o.resilience.zne.extrapolator='exponential'
  o.resilience.zne.amplifier='gate_folding'
 return o


