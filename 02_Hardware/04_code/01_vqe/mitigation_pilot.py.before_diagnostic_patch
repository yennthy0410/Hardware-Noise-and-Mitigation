    js({'available_keys':list(job_inputs.keys()) if isinstance(job_inputs,dict) else [],
        'note':'Submitted base ISA is archived separately. Runtime-transformed circuits may not be returned by IBM.'},p/'job_inputs_inventory.json')
   except Exception as exc:js({'unavailable':str(exc)},p/'job_inputs_inventory.json')
   def metric(key):return metrics.get(key) if isinstance(metrics,dict) else None
   meta={**info,'collected_utc':stamp(),'status':str(job.status()),'metrics_raw':metrics,
         'raw_result_path':str(raw_path),'raw_result_sha256':raw_hash,
         'qpu_usage_s':metric('usage',),
         'timestamps':metric('timestamps'), 'execution_time_s':metric('execution_time'), 'runtime_options_requested':load(p/'mitigation_options_requested.json') if (p/'mitigation_options_requested.json').exists() else None,
         'pub_results':len(rows)}
   # Quantities are read from the original IBM metadata, not estimated.
   if isinstance(metrics,dict):
    usage=metrics.get('usage',{})
    meta['qpu_usage_s']=usage.get('quantum_seconds',usage.get('qpu_seconds')) if isinstance(usage,dict) else (usage if isinstance(usage,(float,int)) else None)
   try:
    meta['job_creation_date_utc']=str(job.creation_date) if not callable(getattr(job,'creation_date',None)) else str(job.creation_date())
   except Exception:pass
   js(_runtime_serializable(meta),p/'job_retrieved_metadata.json')
   js({'base_ISA_sha256':info.get('base_ISA_sha256'),
       'locked_archive_sha256':sha(bundle/'circuit.qpy'),
       'theta_sha256':info.get('theta_sha256'),
       'observables_sha256':info.get('observables_sha256'),
       'job_id':jid,'mitigation_options_requested_path':'mitigation_options_requested.json',
       'note':'Verifies the shared input only. Runtime-internal modified circuits are not claimed.'},
      p/'submitted_circuit_verification.json')
   statusrow.update({'saved_pubs':len(rows),'qpu_usage_s':meta['qpu_usage_s']})
  except Exception as exc:
