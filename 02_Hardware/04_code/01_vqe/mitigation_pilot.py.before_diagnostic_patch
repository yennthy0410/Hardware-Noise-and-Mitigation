def calculate_pub_eis(evs, frequency, zexp):
 """Canonical EIS parameter mapping and per-PUB SSE/RMSE calculation.

 This helper is shared by complete and explicitly partial analysis. Keep the
 scientific operations byte-for-byte equivalent to the original analyze calc.
 """
 import numpy as np
 from parameter_mapping import expectations_to_parameters
 from impedance_model import impedance_model
