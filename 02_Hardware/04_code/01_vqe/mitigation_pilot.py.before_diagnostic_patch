def prepare(args, *, archive_evidence=True):
 root,base,source,out=paths(args)
 qc,obs,theta,physical,ideal,qver=verify_source(source, root)
 records=ibm_round_dir(base,args.round)
 if records.exists() and any(records.iterdir()):
  raise FileExistsError('Refusing to re-prepare existing round records: '+str(records))
 for f in RESULT_FOLDERS:(base/'output'/f).mkdir(parents=True,exist_ok=True)
 bundle=base/'output'/'03_IBM_execution_records'/'locked_inputs'
 bundle.mkdir(parents=True,exist_ok=True)
 if (bundle/'lock.json').exists():
  lock=load(bundle/'lock.json')
  for name,p in [('circuit.qpy',source/'circuit.qpy'),('theta.csv',source/'theta.csv'),('observables.json',source/'observables.json')]:
   if lock['hashes'][name]!=sha(p):raise RuntimeError(f'Locked {name} differs from saved source; use new experiment directory, do not overwrite.')
 else:
  for name in ('circuit.qpy','theta.csv','observables.json'):shutil.copy2(source/name,bundle/name)
  lock={'created_utc':stamp(),'backend':'ibm_fez','dataset':'EIS14','source':str(source),
        'hashes':{n:sha(bundle/n) for n in ['circuit.qpy','theta.csv','observables.json']},
        'physical_observable_qubits':physical,'ideal_expectations':flat(ideal),
        'base_ISA_depth':qc.depth(),'base_ISA_counts':dict(qc.count_ops()),
        'qiskit_version_on_prepare':qver,'shots':args.shots}
  js(lock,bundle/'lock.json')
 # Archive calibration, timing and native-operation evidence without modifying the input run.
 calib_dest=bundle/'studyA_hardware_evidence'
 if archive_evidence and not calib_dest.exists():
  calib_dest.mkdir(parents=True,exist_ok=True)
  evidence_files=['selected_physical_qubits.csv','oneq_operations.csv','twoq_operations.csv',
                  'transpiler_info.json','circuit_timing.json','circuit_coherence_summary.json',
                  'run_config.json','job_retrieved_metadata.json']
  for n in evidence_files:
   if (source/n).is_file():shutil.copy2(source/n,calib_dest/n)
  if (source/'calibrations').is_dir():shutil.copytree(source/'calibrations',calib_dest/'calibrations',dirs_exist_ok=True)
 if archive_evidence:
  js({'noise_scenarios':['measurement_error','gate_error','decoherence'],
      'meaning':'Hardware evidence only; DD/TREX/ZNE are mitigation treatments, not exclusive physical noise switches.',
      'evidence':sorted(str(x.relative_to(calib_dest)) for x in calib_dest.rglob('*') if x.is_file()),
      'source_run':str(source)},calib_dest/'noise_provenance.json')
 # Support the immutable run_02 lock schema without rewriting lock.json.
 # The legacy bundle records shots_requested, rather than shots.
 locked_shots=lock.get('shots',lock.get('shots_requested'))
 if isinstance(locked_shots,bool) or not isinstance(locked_shots,int) or locked_shots<=0:
  raise RuntimeError('Frozen lock has no valid shots/shots_requested integer')
 if locked_shots!=args.shots:
  raise RuntimeError(f'Shots differ from locked inputs: locked={locked_shots}, requested={args.shots}')
 if 'shots' in lock and 'shots_requested' in lock and lock['shots']!=lock['shots_requested']:
  raise RuntimeError('Frozen lock contains contradictory shot counts')
 for name in ('circuit.qpy','theta.csv','observables.json'):
  if not (bundle/name).is_file() or sha(bundle/name)!=lock['hashes'][name]:
   raise RuntimeError(f'Locked bundle file differs from its immutable hash: {name}')
 if 'ideal_expectations' in lock:
  if not np.allclose(lock['ideal_expectations'],ideal,atol=1e-10):
   raise RuntimeError('Ideal expectations differ from locked reference')
 else:
  # This older lock stores hashes of the frozen scientific inputs, but not
  # a derived ideal expectation vector. Recompute it from verified inputs,
  # in memory only; never alter the immutable on-disk lock.
  lock=dict(lock)
  lock['ideal_expectations']=flat(ideal)

 for name,_,_,_ in TREATMENTS:
  p=ibm_round_dir(base,args.round)/name;p.mkdir(parents=True,exist_ok=True)
  save_treatment_options(base,args.round,name,args.shots,lock)
  js({'treatment':name,'flags':dict(zip(['DD','TREX','ZNE'],next(x[1:] for x in TREATMENTS if x[0]==name))),
      'shots_per_PUB_requested':args.shots,'repeats':args.repeats,'source_lock_hashes':lock['hashes']},p/'treatment_plan.json')
 js({'round':args.round,'repeat_count':args.repeats,'treatment_order':[v[0] for v in TREATMENTS],
      'created_utc':stamp(),'locked_inputs':str(bundle),'submission_default':'disabled'},ibm_round_dir(base,args.round)/'round_plan.json')
 print(f'PREPARED: {base}\nSOURCE: {source}\nISA depth={qc.depth()} physical observables={physical}\n')
 print('NO IBM jobs submitted.')
 return root,base,out,lock

def check_lock(base):
 bundle=base/'output'/'03_IBM_execution_records'/'locked_inputs'; lock=load(bundle/'lock.json')
 for n,h in lock['hashes'].items():
  if sha(bundle/n)!=h:raise RuntimeError('Locked input modified: '+n)
 return bundle,lock

def service_obj(args):
 """Select an explicitly saved IBM account or preserve the legacy default.

 --account-label is a provenance label, NOT authentication. --ibm-account
 is the local Qiskit saved-account name. Never persist credentials in results.
 """
 from qiskit_ibm_runtime import QiskitRuntimeService
 if args.ibm_account:
  kw={'name':args.ibm_account}
 else:
  kw={'channel':'ibm_quantum_platform'}
 if args.instance:kw['instance']=args.instance
 try:
  return QiskitRuntimeService(**kw)
 except Exception as exc:
  raise RuntimeError('Cannot open IBM credentials for saved account %r. '
   'Verify QiskitRuntimeService.saved_accounts() and access to the requested instance. '
   'Original error: %s' % (args.ibm_account or '<default>',exc)) from exc

def preflight(args):
 root,base,source,out=paths(args)
 if not (base/'output'/'03_IBM_execution_records/locked_inputs/lock.json').exists():raise FileNotFoundError('No validated locked bundle; preparation must be explicit')
 bundle,lock=check_lock(base)
 qc,obs,theta,physical,ev,_=verify_source(bundle, root)
 from qiskit_ibm_runtime import __version__ as runtime_version
 configs={}
 for name,*_ in TREATMENTS:
  opts=configuration(name,args.shots)
  configs[name]=opts.model_dump(mode='json') if hasattr(opts,'model_dump') else str(opts)
 report={'timestamp_utc':stamp(),'base_isa_sha256':lock['hashes']['circuit.qpy'],
         'observables_sha256':lock['hashes']['observables.json'],
         'theta_sha256':lock['hashes']['theta.csv'],'ideal_expectations':flat(ev),
         'physical_observable_qubits':physical,'repeats':args.repeats,'shots':args.shots,
         'estimated_PUB_count':len(TREATMENTS)*args.repeats,'runtime_version':runtime_version,
         'options':configs,'IBMQPU_submission':False}
 if args.online:
  svc=service_obj(args);backend=svc.backend('ibm_fez')
  report['backend_status']=str(backend.status())
  # Ensure a real backend accepts native ISA instruction names/physical indices.
  unsupported=[]
  for instruction in qc.data:
   op=instruction.operation.name
   qubits=tuple(qc.find_bit(q).index for q in instruction.qubits)
   if op not in ['barrier','delay'] and not backend.target.instruction_supported(operation_name=op,qargs=qubits):unsupported.append((op,qubits))
  report['unsupported_instructions']=unsupported
  if unsupported:raise RuntimeError(f'Unsupported ISA: {unsupported[:6]}')
 js(report,ibm_round_dir(base,args.round)/'preflight_report.json')
 print('PREFLIGHT PASS; submit not invoked. Physical qubits:',physical)
 return report

def submit(args):
 if not args.submit:raise RuntimeError('Submission disabled: add --submit to authorize QPU jobs')
 preflight(args)
 root,base,source,out=paths(args);bundle,lock=check_lock(base)
 qc,obs,theta,*_=verify_source(bundle, root)
 from qiskit_ibm_runtime import EstimatorV2
 plans=[x[0] for x in TREATMENTS if args.treatment is None or x[0]==args.treatment]
 if not plans:raise RuntimeError(f'Unknown treatment: {args.treatment}')
 if args.shuffle:plans=list(np.random.default_rng(args.shuffle_seed).permutation(plans))
 record_root=ibm_round_dir(base,args.round)
 existing=[n for n in plans if (record_root/n/'job_submitted.json').exists()]
 ambiguous=[n for n in plans if (record_root/n/'submission_state.json').exists() and
            load(record_root/n/'submission_state.json').get('status')=='SUBMITTING' and
            not (record_root/n/'job_submitted.json').exists()]
 if ambiguous:
  raise RuntimeError('UNCERTAIN SUBMISSIONS '+str(ambiguous)+'. IBM might have accepted a job before client lost connection. '
    'Check Jobs in the originating IBM account; use reconcile --treatment NAME --job-id ID if found, '
    'or reconcile --treatment NAME --confirm-not-submitted ONLY after verifying no job exists.')
 if existing and not args.resume:
  raise RuntimeError(f'Existing job IDs: {existing}; use --resume to skip them')
 svc=service_obj(args);backend=svc.backend('ibm_fez')
 count=0
 for name in plans:
  p=record_root/name; submitted=p/'job_submitted.json';state=p/'submission_state.json'
  if submitted.exists():continue
  if state.exists():
   st=load(state)
   if st.get('status') not in ('CONFIRMED_NOT_SUBMITTED',):
    raise RuntimeError(f'Unresolved state for {name}: {st.get("status")}. Manual reconciliation required.')
  if count>=args.max_jobs:break
  check_lock(base);save_treatment_options(base,args.round,name,args.shots,lock)
  attempt=uuid.uuid4().hex
  claim={'status':'SUBMITTING','attempt_id':attempt,'created_utc':stamp(),
         'account_label':account_key(args),'instance':args.instance,'treatment':name,
         'locked_hashes_sha256':lock['hashes'],'repeats':args.repeats,'shots':args.shots}
  # Existing CONFIRMED_NOT_SUBMITTED state is overwritten only after a fresh claim marker.
  # A separate O_EXCL marker blocks two processes racing to submit the same treatment.
  guard=p/'submit_guard.lock'
  try:exclusive_json({'attempt_id':attempt,'created_utc':stamp()},guard)
  except FileExistsError:raise RuntimeError(f'Existing submission lock for {name}: {guard}; stop and inspect')
  try:
   if submitted.exists():raise RuntimeError(f'Concurrent submission already recorded for {name}')
   if state.exists() and load(state).get('status')!='CONFIRMED_NOT_SUBMITTED':
    raise RuntimeError(f'Unexpected state change for {name}')
   atomic_json(claim,state)  # written BEFORE any network submission
   opts=configuration(name,args.shots)
   est=EstimatorV2(mode=backend,options=opts)
   pubs=[(qc,obs)]*args.repeats
   job=est.run(pubs)
   jid=job.job_id()
   info={'job_id':jid,'backend':'ibm_fez','treatment':name,'submitted_client_utc':stamp(),
         'account_label':account_key(args),'instance':args.instance,'attempt_id':attempt,
         'repeats':args.repeats,'shots_requested_per_pub':args.shots,
         'base_ISA_sha256':lock['hashes']['circuit.qpy'],'theta_sha256':lock['hashes']['theta.csv'],
         'observables_sha256':lock['hashes']['observables.json'],
         'locked_input_path':'../../locked_inputs/circuit.qpy',
         'mitigation_options_file':'mitigation_options_requested.json'}
   # Persist ID before marking the submission complete.
   exclusive_json(info,submitted)
   atomic_json({**claim,'status':'SUBMITTED','job_id':jid,'updated_utc':stamp()},state)
   print('SUBMITTED',name,jid,'account=',account_key(args),'instance=',args.instance,flush=True)
   count+=1
  except Exception:
   # Intentionally DO NOT discard SUBMITTING. A failed network request may still have
   # created a chargeable job. Refuse automatic retries until explicit reconciliation.
   raise
  finally:
   # Only remove lock if it belongs to this attempt. Keep state ledger permanent.
   if guard.exists() and load(guard).get('attempt_id')==attempt:guard.unlink()
