def _validated_rows(rows, expected_n, label):
 """Reject partial, non-finite or mislabeled QPU results before publishing."""
 import math
 cols=[f'Z{i}' for i in range(7)]+[f'std_Z{i}' for i in range(7)]
 if len(rows)!=expected_n:raise ValueError(f'{label}: expected {expected_n} PUBs, got {len(rows)}')
 pubs=[]
 for r in rows:
  pub=int(r['pub']);pubs.append(pub)
  for c in cols:
   x=float(r[c])
   if not math.isfinite(x) or (c.startswith('std_') and x<0):
    raise ValueError(f'{label}: PUB {pub} invalid {c}={x!r}')
 if sorted(pubs)!=list(range(1,expected_n+1)):
  raise ValueError(f'{label}: invalid PUB indices {pubs}')
 return rows

def _recovery_overlay(base,round_name,treatment,rows,original_job_id):
 """Overlay validated 1-PUB recovery with immutable source attribution."""
 import math
 import csv as _csv
 from pathlib import Path as _Path
 folder=base/'output'/'03_IBM_execution_records'/'pub_recovery'
 result=[dict(r) for r in rows]
 source={int(r['pub']):original_job_id for r in result}
 changes=[]
 try:n=int(round_name.split('=',1)[1])
 except (IndexError,ValueError):return result,source,changes
 for d in sorted(folder.glob(f'n{n}_{treatment}_PUB*')) if folder.exists() else []:
  provenance=d/'recovery_provenance.json'; csvfile=d/'recovery_expectations.csv'
  if not provenance.exists() or not csvfile.exists():continue
  info=load(provenance)
  pub=int(info['pub'])
  if (int(info['n'])!=n or info['treatment']!=treatment or
      info['original_job_id']!=original_job_id or pub not in source or
      not info.get('replacement_job_id')):
   raise ValueError(f'Invalid recovery provenance: {d}')
  with csvfile.open(encoding='utf-8-sig',newline='') as f: replacement=list(_csv.DictReader(f))
  if len(replacement)!=1 or int(replacement[0]['pub'])!=pub:
   raise ValueError(f'Recovery PUB index mismatch: {d}')
  _validated_rows([dict(replacement[0],pub=1)],1,str(csvfile))
  idx=next(i for i,r in enumerate(result) if int(r['pub'])==pub)
  for col in [f'Z{i}' for i in range(7)]+[f'std_Z{i}' for i in range(7)]:
   result[idx][col]=float(replacement[0][col])
  source[pub]=info['replacement_job_id']
  changes.append({'pub':pub,'original_job_id':original_job_id,'recovery_job_id':info['replacement_job_id'],'recovery_account':info.get('account')})
 return result,source,changes

def collect(args, *, assistant_safe=False, service_override=None, pub_observer=None):
 root,base,source,out=paths(args);bundle,lock=check_lock(base)
 from qiskit_ibm_runtime import RuntimeEncoder
 svc=service_override;statuses=[]
 for name,*_ in TREATMENTS:
  p=ibm_round_dir(base,args.round)/name; submitted=p/'job_submitted.json'
  if not submitted.exists():statuses.append({'treatment':name,'status':'not_submitted'});continue
  info=load(submitted);jid=info['job_id']; statusrow={'treatment':name,'job_id':jid,
     'submitted_account_label':info.get('account_label'),'submitted_instance':info.get('instance')}
  if (p/'result.json').exists() and (p/'expectations.csv').exists():
   try:
    with (p/'expectations.csv').open(encoding='utf-8-sig',newline='') as f:existing=list(csv.DictReader(f))
    _validated_rows(existing,args.repeats,str(p/'expectations.csv'))
    statuses.append({**statusrow,'status':'ALREADY_COLLECTED_VALIDATED'});continue
   except Exception as exc:
    # Never overwrite an existing, possibly merged dataset on an automatic collect.
    statuses.append({**statusrow,'status':'EXISTING_CSV_INVALID_NO_OVERWRITE','error':str(exc)});continue
  if not identity_matches(info,args):
   statuses.append({**statusrow,'status':'OTHER_ACCOUNT_OR_INSTANCE',
      'note':'Run collect with the original --account-label and --instance'});continue
  try:
   if svc is None:svc=service_obj(args)
   job=svc.job(jid); statusrow['status']=str(job.status())
   if str(job.status()).upper() not in ('DONE','COMPLETED','JOBSTATUS.DONE'):
    statuses.append(statusrow);continue
   result=job.result()
   # Preserve each IBM response before validating or publishing CSV outputs.
   # Content-addressed, create-only archives make repeated retrieval idempotent
   # and keep partial/corrupt responses available for recovery diagnosis.
   raw_value=_runtime_serializable(result)
   raw_bytes=json.dumps(raw_value,ensure_ascii=False,sort_keys=True,indent=2,default=str).encode('utf-8')
   raw_key=hashlib.sha256(raw_bytes).hexdigest()
   raw_dir=p/'raw_retrievals';raw_dir.mkdir(parents=True,exist_ok=True)
   raw_path=raw_dir/f'job_result_{raw_key}.json'
   if raw_path.exists():
    if json.loads(raw_path.read_text(encoding='utf-8'))!=raw_value:
     raise RuntimeError('Content-addressed raw result archive conflicts; refusing overwrite')
   else:
    with raw_path.open('xb') as raw_handle:
     raw_handle.write(raw_bytes);raw_handle.flush();os.fsync(raw_handle.fileno())
   # Hash the exact immutable bytes used by per-PUB provenance records.
   raw_hash=hashlib.sha256(raw_path.read_bytes()).hexdigest()
   statusrow.update({'raw_result_path':str(raw_path),'raw_result_sha256':raw_hash})
   # Persist provider-side metadata immediately after the immutable result
   # archive and before PUB decoding, validation, CSV creation, or analysis.
   # Metadata API failures remain explicit and do not discard the result.
   provider_metadata_errors=[]
   try:metrics=job.metrics() if callable(getattr(job,'metrics',None)) else {}
   except Exception as meta_exc:
    metrics={};provider_metadata_errors.append({'field':'metrics','error_type':type(meta_exc).__name__})
   provider_timestamps={}
   for attr in ('creation_date','start_time','end_time','done'):
    try:value=getattr(job,attr,None)
    except Exception as meta_exc:
     provider_metadata_errors.append({'field':attr,'error_type':type(meta_exc).__name__});value=None
    if callable(value):
     try:value=value()
     except Exception as meta_exc:
      provider_metadata_errors.append({'field':attr,'error_type':type(meta_exc).__name__});value=None
    if value is not None:provider_timestamps[attr]=str(value)
   provider_pubs=[]
   for pub_index,pub in enumerate(result,1):
    try:pub_metadata=_runtime_serializable(getattr(pub,'metadata',{}))
    except Exception as meta_exc:
     pub_metadata={};provider_metadata_errors.append({'field':f'pub_{pub_index}_metadata','error_type':type(meta_exc).__name__})
    try:data_fields=_pub_data_fields(pub)
    except Exception as meta_exc:
     data_fields={};provider_metadata_errors.append({'field':f'pub_{pub_index}_data_fields','error_type':type(meta_exc).__name__})
    provider_pubs.append({'pub':pub_index,'metadata':pub_metadata,'data_fields':data_fields})
   provider_envelope={'schema_version':1,'job_id':jid,'job_status':statusrow.get('status'),
    'raw_result_sha256':raw_hash,'metrics':_runtime_serializable(metrics),
    'timestamps':provider_timestamps,'pubs':provider_pubs,
    'metadata_errors':provider_metadata_errors}
   metadata_bytes=json.dumps(provider_envelope,ensure_ascii=False,sort_keys=True,indent=2,default=str).encode('utf-8')
   metadata_hash=hashlib.sha256(metadata_bytes).hexdigest()
   metadata_path=raw_dir/f'provider_metadata_{metadata_hash}.json'
   if not metadata_path.exists():
    try:
     with metadata_path.open('xb') as metadata_handle:
      metadata_handle.write(metadata_bytes);metadata_handle.flush();os.fsync(metadata_handle.fileno())
    except FileExistsError:pass
   elif hashlib.sha256(metadata_path.read_bytes()).hexdigest()!=metadata_hash:
    raise RuntimeError('Content-addressed provider metadata archive conflicts; refusing overwrite')
   statusrow.update({'provider_metadata_path':str(metadata_path),'provider_metadata_sha256':metadata_hash,
    'provider_metadata_errors':provider_metadata_errors})
   # Optional integration hook: observers see the already-archived provider
   # result before the strict all-PUB publication validator runs. The default
   # CLI path remains unchanged; observers must not alter result objects.
   if pub_observer is not None:
    pub_observer(name,jid,result,str(raw_path),raw_hash,job)
   # Preserve raw IBM result as-is. Publish CSV only after validation/overlay.
   rows=[];zs=[]
   for i,pr in enumerate(result):
