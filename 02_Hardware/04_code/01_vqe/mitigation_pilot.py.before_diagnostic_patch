    for idx,name in enumerate(ordered):
        ax=axes.flat[idx]
        series=df.loc[df.treatment==name].sort_values('pub').SSE.to_numpy(dtype=float)
        ns=np.arange(2,len(series)+1)
        medians=[]; lo=[]; hi=[]
        for n in ns:
            chunk=series[:n]; repl=rng.choice(chunk,size=(bootstrap,n),replace=True)
            meds=np.median(repl,axis=1)
            medians.append(float(np.median(chunk)))
            low,high=np.quantile(meds,[.025,.975]);lo.append(float(low));hi.append(float(high))
            details.append({'treatment':name,'sample_size':int(n),'median_SSE':float(medians[-1]),
                            'bootstrap_CI_2.5':float(low),'bootstrap_CI_97.5':float(high),
                            'CI_upper_over_lower':float(high/low) if low>0 else np.nan,
                            'bootstrap_draws':bootstrap,'round':round_name})
        color=cols[0] if name!='M0_Baseline' else cols[1]
        if len(ns):
            ax.plot(ns,medians,'-o',color=color,linewidth=1.7,markersize=4)
            ax.fill_between(ns,lo,hi,color=color,alpha=.19)
            ax.xaxis.set_major_locator(MaxNLocator(integer=True))
            if len(ns)>1:ax.set_xlim(max(1,ns[0]-.3),ns[-1]+.3)
            if np.all(np.array(lo)>0):ax.set_yscale('log')
            label=f'n={len(series)}: 95% CI [{lo[-1]:.3g}, {hi[-1]:.3g}]'
            ax.text(.04,.05,label,transform=ax.transAxes,fontsize=8,
                    bbox={'boxstyle':'round','facecolor':'white','alpha':.85,'edgecolor':'#d1d5db'})
        else:
            ax.text(.5,.5,'At least two PUB results required',ha='center',va='center',transform=ax.transAxes,fontsize=9)
        ax.set_title(treatment_display(name),fontsize=11)
        ax.set_xlabel('Cumulative repeated PUB count n',fontsize=9)
        ax.set_ylabel('Median SSE (Ω²)',fontsize=9)
        ax.grid(alpha=.18)
    fig.text(.5,.005,'Pilot estimates only. A five-PUB job does not establish between-job or between-day reproducibility.',
             ha='center',va='bottom',fontsize=10,color='#8b3a3a')
    fig.tight_layout(rect=(0,.035,1,.945))
    outfile='05_mitigation_median_CI_convergence.png'
    fig.savefig(out/outfile,dpi=600,bbox_inches='tight');plt.close(fig)
    pd.DataFrame(details).to_csv(out/'median_bootstrap_convergence.csv',index=False)
    # Figure D: real baselines only. Use explicit classical SSE when supplied, otherwise
    # normalize to newly measured QPU M0 baseline, and state this explicitly.
    stats={x['treatment']:x for x in tables}
    baseline=stats.get('M0_Baseline',{}).get('median_SSE',np.nan)
    reference=float(classical_sse) if classical_sse is not None else float(baseline)
    ref_label='Classical SSE = 1×' if classical_sse is not None else 'Measured QPU Baseline = 1×'
    if not np.isfinite(reference) or reference<=0:raise ValueError('Positive baseline/classical SSE required for positioning')
    fig,ax=plt.subplots(figsize=(12,6));records=[]
    for j,name in enumerate(ordered):
        sub=df.loc[df.treatment==name].SSE.to_numpy(dtype=float)
        if len(sub)==0:continue
        med=float(np.median(sub));lo_ci=hi_ci=np.nan
        if len(sub)>1:
            repl=rng.choice(sub,size=(bootstrap,len(sub)),replace=True)
            lo_ci,hi_ci=map(float,np.quantile(np.median(repl,axis=1),[.025,.975]))
        ratio=med/reference
        lowerr=max(0,med-lo_ci)/reference if np.isfinite(lo_ci) else 0
        upperr=max(0,hi_ci-med)/reference if np.isfinite(hi_ci) else 0
        color='#277DA1' if med<float(baseline) else '#E07636'
        ax.errorbar(j,ratio,yerr=np.array([[lowerr],[upperr]]),fmt='o',markersize=9,
                    capsize=5,color=color,ecolor=color,linewidth=1.7)
        records.append({'treatment':name,'median_SSE':med,'median_SSE_over_reference':ratio,
                        'bootstrap_CI_low_over_reference':lo_ci/reference if np.isfinite(lo_ci) else np.nan,
                        'bootstrap_CI_high_over_reference':hi_ci/reference if np.isfinite(hi_ci) else np.nan,
                        'reference_type':'classical' if classical_sse is not None else 'new_qpu_baseline',
                        'reference_SSE':reference})
    ax.axhline(1.0,color='black',ls='--',lw=1.4,label=ref_label)
    if ideal_sse is not None and np.isfinite(ideal_sse) and ideal_sse>0:
        ax.axhline(ideal_sse/reference,color='#2d8a52',ls=':',lw=1.8,label='Noiseless ideal reference')
    if random_sse is not None and random_sse>0:
        ax.axhline(random_sse/reference,color='#ad4343',ls='-.',lw=1.2,label='Provided random-control reference')
    ax.set_xticks(range(8),[treatment_display(n) for n in ordered],rotation=20,ha='right')
    ax.set_ylabel('Median SSE / reference SSE (log scale)')
    ax.set_title('Mitigation Performance Relative to Measured References',fontweight='bold',fontsize=15)
    ax.set_yscale('log');ax.grid(axis='y',alpha=.22,which='both');ax.legend(loc='best',fontsize=9)
    ax.text(.01,.025,'Error bars: bootstrap 95% CI of median; pilot PUB replicates only.\n'
            'Colors: lower vs higher SSE than measured QPU baseline, not statistically established tiers.',
            transform=ax.transAxes,fontsize=9,color='#444')
    fig.tight_layout();outfile2='06_mitigation_three_tier_positioning.png'
    fig.savefig(out/outfile2,dpi=600,bbox_inches='tight');plt.close(fig)
    pd.DataFrame(records).to_csv(out/'mitigation_positioning_data.csv',index=False)
    for fn in ['05_mitigation_median_CI_convergence.png','06_mitigation_three_tier_positioning.png',
               'median_bootstrap_convergence.csv','mitigation_positioning_data.csv']:
        shutil.copy2(out/fn,figure_dir/f'{round_name}_{fn}')

def final_figures(args):
 """Pool all *completed* rounds; never manufacture data at unmeasured sample sizes.

 Requires two or more separately submitted rounds and >=20 PUB observations
 for every treatment. More data may be necessary for stable confidence intervals.
 """
 import pandas as pd
 root,base,source,_=paths(args)
 rounds=base/'output'/'02_run_level_data'
 pieces=[];included=[]
 for r in sorted(rounds.iterdir() if rounds.is_dir() else []):
  f=r/'per_repeat.csv'
  if not r.is_dir() or not f.exists():continue
  frame=pd.read_csv(f)
  if frame.empty or not {'treatment','pub','SSE'}.issubset(frame.columns):continue
  frame=frame.copy();frame['source_round']=r.name
  pieces.append(frame);included.append(r.name)
 if len(pieces)<2:
  raise RuntimeError('Figure C/D deferred: collect and analyze at least 2 independent rounds, e.g. n=5 and n=10.')
 all_data=pd.concat(pieces,ignore_index=True)
 counts=all_data.groupby('treatment').size()
 missing=[name for name,*_ in TREATMENTS if counts.get(name,0)<20]
 if missing:raise RuntimeError('Figure C/D deferred: require >=20 measured PUB results for EACH treatment. Missing: '+str(missing))
 pool=base/'output'/'01_results_and_figures'/'pooled'
 if pool.exists() and any(pool.iterdir()):
  raise FileExistsError('Pooled scientific output already exists: '+str(pool))
 pool.mkdir(parents=True,exist_ok=True)
 csvout(pool/'pooled_per_repeat.csv',all_data.to_dict('records'))
 summary=[]
 for name,*_ in TREATMENTS:
  a=all_data.loc[all_data.treatment==name,'SSE'].astype(float).to_numpy()
  summary.append({'treatment':name,'n':len(a),'median_SSE':float(np.median(a)),
                  'mean_SSE':float(np.mean(a)),'std_SSE':float(np.std(a,ddof=1)),
                  'IQR_SSE':float(np.percentile(a,75)-np.percentile(a,25))})
 bundle,lock=check_lock(base)
 register_science(root)
 from parameter_mapping import expectations_to_parameters
 from impedance_model import impedance_model,read_eis_file
 freq,zexp=read_eis_file(str(Path(args.data) if args.data else root/'data/EIS14.csv'))
 freq=np.asarray(freq,float);zexp=np.asarray(zexp,complex)
 p,_=expectations_to_parameters(np.clip(np.asarray(lock['ideal_expectations'],float),-1,1))
 import inspect
 if set(NAMES).issubset(inspect.signature(impedance_model).parameters):zideal=np.asarray(impedance_model(freq,**p),complex)
 else:zideal=np.asarray(impedance_model(freq,p),complex)
 ideal=float(np.sum(np.abs(zideal-zexp)**2))
 create_mos2_style_figures(all_data,summary,pool,pool,'pooled',ideal,
                           classical_sse=args.classical_sse,random_sse=args.random_sse,
                           seed=args.bootstrap_seed,bootstrap=args.bootstrap_draws)
 js({'source_rounds':included,'counts_by_treatment':counts.to_dict(),
     'note':'Grouped PUB observations; job/batch effects are not fully captured by ordinary bootstrap.'},pool/'pooled_manifest.json')
 print('POOLED Figures C/D created using measured rounds:',included,'folder:',pool)

